# Menu
menu.border.color: #3e3e3a

menu.title.bg: Solid Flat
menu.title.bg.color: #3e3e3a
menu.title.bg.shadow: 0
menu.title.text.color: #dfd6b2
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #3e3e3a
menu.items.text.color: #dfd6b2
menu.items.disabled.text.color: #b6b094

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #8d8974
menu.items.active.text.color: #dfd6b2

menu.separator.color: #b6b094
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #3e3e3a

# Active window
window.active.border.color: #8d8974


window.active.title.bg: flat solid
window.active.title.bg.color: #3e3e3a
window.active.title.separator.color: #3e3e3a
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #dfd6b2

window.active.handle.bg: flat solid
window.active.handle.bg.color: #3e3e3a

window.active.grip.bg: flat solid
window.active.grip.bg.color: #3e3e3a

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #3e3e3a
window.active.button.unpressed.image.color: #dfd6b2

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #8d8974
window.active.button.pressed.image.color: #3e3e3a

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #3e3e3a
window.active.button.disabled.image.color: #b6b094

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #3e3e3a
window.active.button.hover.image.color: #8d8974

#window.active.button.toggled.bg: #8d8974
#window.active.button.toggled.image.color: #3e3e3a

# Inactive window
window.inactive.border.color: #3e3e3a

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #3e3e3a
window.inactive.title.separator.color: #3e3e3a
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #b6b094

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #3e3e3a

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #3e3e3a

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #3e3e3a
window.inactive.button.unpressed.image.color: #b6b094

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #8d8974
window.inactive.button.pressed.image.color: #3e3e3a

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #b6b094
window.inactive.button.disabled.image.color: #3e3e3a

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #3e3e3a
window.inactive.button.hover.image.color: #8d8974


# OSD
osd.border.width: 1
osd.border.color: #8d8974

osd.bg: flat solid
osd.bg.color: #3e3e3a
osd.label.bg: flat solid
osd.label.bg.color: #3e3e3a
osd.label.text.color: #dfd6b2

# OSD
osd.bg: Solid Flat
osd.bg.color: #3e3e3a
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #8d8974
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #dfd6b2

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #719b92
#osd.button.unpressed.*.border.color: #3e3e3a

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #8d8974
#osd.button.pressed.*.border.color: #3e3e3a

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #3e3e3a
#osd.button.focused.*.border.color: #dfd6b2

osd.button.focused.box.color: #8d8974


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
